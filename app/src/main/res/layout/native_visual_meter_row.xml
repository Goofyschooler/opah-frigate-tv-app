<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/native_visual_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/native_opah_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/native_visual_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/native_opah_text_secondary"
        android:textSize="14sp" />

    <app.opah.tv.ui.views.NativeMeterView
        android:id="@+id/native_visual_meter"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="9dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/native_visual_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/native_opah_text_secondary"
        android:textSize="14sp" />
</LinearLayout>
